  "decisions": [
    {
      "id": "decision_d001",
      "title": "Adopt Kafka for Atlas change feed",
      "project": "project_atlas",
      "technology": "tech_kafka",
      "proposed_by": "person_carol",
      "approved_by": "person_alice",
      "date": "2026-02-12",
      "rationale": "Atlas needed replayable, ordered product and behavior updates. Kafka provided durable event history and decoupled producers from ranking consumers.",
      "alternatives": [
        "Direct database polling",
        "Managed queue without replay"
      ]
    },
    {
      "id": "decision_d002",
      "title": "Standardize Elasticsearch mappings for Atlas",
      "project": "project_atlas",
      "technology": "tech_elasticsearch",
      "proposed_by": "person_george",
      "approved_by": "person_alice",
      "date": "2026-02-28",
      "rationale": "Inconsistent field mappings caused relevance drift across indexes. A shared template made analyzers and ranking fields predictable.",
      "alternatives": [
        "Per-index mappings",
        "Schema-on-read"
      ]
    },
    {
      "id": "decision_d003",
      "title": "Deploy Atlas ranking services on Kubernetes",
      "project": "project_atlas",
      "technology": "tech_kubernetes",
      "proposed_by": "person_hannah",
      "approved_by": "person_alice",
      "date": "2026-03-15",
      "rationale": "The team needed controlled rollouts, autoscaling, and standard health checks for ranking services.",
      "alternatives": [
        "Long-running VMs",
        "Serverless functions"
      ]
    },
    {
      "id": "decision_d004",
      "title": "Use Redis for Phoenix online feature cache",
      "project": "project_phoenix",
      "technology": "tech_redis",
      "proposed_by": "person_bob",
      "approved_by": "person_farah",
      "date": "2026-04-03",
      "rationale": "Phoenix required predictable sub-20ms feature lookups during recommendation ranking. Redis met latency and operational requirements.",
      "alternatives": [
        "Read directly from PostgreSQL",
        "In-process cache only"
      ]
    },
    {
      "id": "decision_d005",
      "title": "Use Kafka as Phoenix behavior event bus",
      "project": "project_phoenix",
      "technology": "tech_kafka",
      "proposed_by": "person_carol",
      "approved_by": "person_farah",
      "date": "2026-04-11",
      "rationale": "Recommendation features needed near-real-time user behavior with replay for backfills. Kafka aligned Phoenix with the company streaming standard.",
      "alternatives": [
        "Batch files every hour",
        "Point-to-point queues"
      ]
    },
    {
      "id": "decision_d006",
      "title": "Use PostgreSQL for Nova investigation cases",
      "project": "project_nova",
      "technology": "tech_postgresql",
      "proposed_by": "person_isaac",
      "approved_by": "person_david",
      "date": "2026-05-07",
      "rationale": "Investigation cases required transactional updates, auditability, and flexible analyst queries.",
      "alternatives": [
        "Document database",
        "Flat files"
      ]
    },
    {
      "id": "decision_d007",
      "title": "Use Airflow for Mercury settlement workflows",
      "project": "project_mercury",
      "technology": "tech_airflow",
      "proposed_by": "person_elena",
      "approved_by": "person_julia",
      "date": "2026-05-22",
      "rationale": "Settlement jobs have dependencies, retries, and cutoff windows. Airflow made orchestration and operational visibility explicit.",
      "alternatives": [
        "Cron jobs",
        "Custom scheduler"
      ]
    },
    {
      "id": "decision_d008",
      "title": "Use PostgreSQL as Mercury reconciliation ledger",
      "project": "project_mercury",
      "technology": "tech_postgresql",
      "proposed_by": "person_elena",
      "approved_by": "person_julia",
      "date": "2026-05-29",
      "rationale": "Mercury needed a transactional source of truth for settlement status, discrepancies, and audit trails.",
      "alternatives": [
        "Object storage tables",
        "Key-value store"
      ]
    }
  ],
